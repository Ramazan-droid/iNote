<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Update Note</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f2f2f2; padding: 20px; }
    form { background: white; padding: 20px; border-radius: 8px; max-width: 500px; margin: auto; }
    label { display: block; margin-top: 10px; }
    input[type=text], textarea { width: 100%; padding: 8px; margin-top: 5px; }
    button { margin-top: 15px; padding: 8px 15px; background: #3498db; color: white; border: none; border-radius: 4px; cursor: pointer; }
  </style>
</head>
<body>
  <h1>Update Note</h1>
  <form action="/admin/updatenote/<%= note._id %>" method="POST">
    <label>Title</label>
    <input type="text" name="title" value="<%= note.title %>" required>

    <label>Content</label>
    <textarea name="content" rows="5" required><%= note.content %></textarea>

    <label>
      <input type="checkbox" name="is_pinned" <%= note.is_pinned ? "checked" : "" %>>
      Pinned
    </label>

    <button>Update Note</button>
  </form>
</body>
</html>
