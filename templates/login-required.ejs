<!DOCTYPE html>
<html>
<head>
  <title>Login Required</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f2f2f2;
      display: flex;
      height: 100vh;
      justify-content: center;
      align-items: center;
    }
    .box {
      background: white;
      padding: 30px;
      border-radius: 8px;
      text-align: center;
    }
    .btn {
      margin: 10px;
      padding: 10px 18px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="box">
    <h2>You must be logged in to view your notes</h2>
    <a href="/login"><button class="btn">Login</button></a>
    <a href="/signup"><button class="btn">Sign up</button></a>
  </div>
</body>
</html>
